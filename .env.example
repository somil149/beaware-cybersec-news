# Database
DATABASE_URL="postgresql://user:password@localhost:5432/beaware_cybersec?schema=public"

# NextAuth Configuration
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-secret-key-here-generate-with-openssl-rand-base64-32"

# OAuth Providers (Optional)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# News API
NEWS_API_KEY="your-newsapi-key-here"

# Email Service (for newsletters)
RESEND_API_KEY="your-resend-api-key-here"
EMAIL_FROM="noreply@beaware.cybersectoday.org"

# Application
NODE_ENV="development"
APP_URL="http://localhost:3000"

# Rate Limiting
RATE_LIMIT_MAX_REQUESTS="100"
RATE_LIMIT_WINDOW_MS="900000"

# Cache Configuration
REDIS_URL="" # Optional: for Redis caching
CACHE_TTL="3600"

# Cron Job Security
CRON_SECRET="your-cron-secret-here-generate-with-openssl-rand-base64-32"